.env
__pycache__/
*.pyc
cache/
tmp/
.venv/
*.egg-info/
build/
dist/
music/
go-librespot/credentials.json
go-librespot/lockfile
go-librespot/state.json
.spotify_token_cache
.cache
.claude/
.gstack/
# Track the shared Conductor contract; keep personal overrides and other
# workspace-local Conductor state ignored.
!.conductor/
.conductor/*
!.conductor/settings.toml
*.app
*.webloc
.coverage
# Per-process data files from [tool.coverage.run] parallel mode (needed so
# coverage can follow the spawned HA projection worker). A completed run
# combines and erases them; an interrupted one leaves them behind.
.coverage.*
coverage.json
htmlcov/
.playwright-cli/
# Ephemeral render staging dir (scripts/generate_welcome_clips.py) — never
# commit/package a partial render left by an interrupted run.
**/.staging/

# Playwright QA scratch — ad-hoc visual-capture scripts + screenshots, regenerable, never committed.
output/

# Contract-window marker — created only by Florian to open a contract
# maintenance window (see CONTRACT.md). Never committed.
.contract-window
